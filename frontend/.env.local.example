# Copy to .env.local and adjust as needed.
# Base URL of the Spring Boot scan API, as the BROWSER sees it.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Where server-side route handlers (/site-api/*) reach the API. Only differs from
# the value above when the site and the API see the backend at different addresses
# — in docker that is http://backend:8080. Defaults to the URL above when unset.
# GENEAV_API_INTERNAL_URL=http://localhost:8080

# API key the homepage demo scanner and chat widget scan with, since /api/v1/scan
# and /api/v1/chat now require one. Mint one against your local backend:
#   curl -sX POST localhost:8080/api/v1/signup \
#        -H 'Content-Type: application/json' -d '{"email":"demo@localhost"}'
# and paste the returned "apiKey" here. Unset just means the demo answers 503.
GENEAV_DEMO_API_KEY=
