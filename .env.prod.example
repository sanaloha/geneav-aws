# Copy to .env.prod on the VM, set GENEAV_HOST, then deploy with:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# GENEAV_HOST is the public hostname Caddy serves (and obtains a Let's Encrypt
# certificate for). It also becomes the frontend's build-time API base URL and the
# backend's allowed CORS origin, so a domain change requires a rebuild.
#
# Production uses a registered domain whose A record points at the VM's STATIC
# public IP (e.g. geneav.com -> 172.190.148.55). www is redirected to the apex
# in caddy/Caddyfile.
#
# No registered domain? Use a free nip.io wildcard derived from the IP instead:
#   IP 20.1.2.3  ->  GENEAV_HOST=geneav.20-1-2-3.nip.io   (no DNS records needed)
# If Let's Encrypt rate-limits the shared nip.io domain, use sslip.io the same way.

GENEAV_HOST=geneav.com

# Chat assistant (OpenAI). Leave empty to keep chat disabled. Put the REAL key
# only in .env.prod (gitignored) on the VM — never commit it to this example.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Transactional email (signup acknowledgement; password reset once GN-8 lands).
#
# GENEAV_MAIL_ENABLED=true ALONE DOES NOT SEND MAIL. Without a reachable
# SMTP_HOST the send fails and logs a warning on every signup. Set the three
# SMTP_* values below at the same time, or leave GENEAV_MAIL_ENABLED=false.
#
# Provider: Resend (https://resend.com). Get the credentials by:
#   1. Domains -> Add Domain -> geneav.com, region us-east-1 (VM is in eastus)
#   2. Add the MX + SPF/DKIM records it shows to the registrar's DNS for
#      geneav.com, then click Verify. Until Verified, Resend only delivers to
#      your own account address.
#   3. API Keys -> Create API Key (Sending access). Shown ONCE — copy it.
# The API key IS the SMTP password; the username is the literal string "resend".
#
# Put the REAL key only in .env.prod (gitignored, root-owned) on the VM — never
# here. Keep port 587: Azure blocks outbound port 25 on VMs.
#
# GENEAV_MAIL_FROM must be on the verified domain or the provider rejects it.
# Without the DKIM/SPF records, password-reset mail (GN-8) lands in spam.
GENEAV_MAIL_ENABLED=true
SMTP_HOST=smtp.resend.com
SMTP_USERNAME=resend
SMTP_PASSWORD=
# SMTP_PORT=587                        # 587 = STARTTLS (the default); 465 = implicit TLS
# GENEAV_MAIL_FROM=no-reply@geneav.com
# GENEAV_MAIL_FROM_NAME=geneav
# GENEAV_MAIL_LOGIN_URL is set automatically from GENEAV_HOST by the prod compose.

# PostgreSQL (accounts, API keys, usage). REQUIRED in prod — the prod compose
# refuses to start without it. Use a strong, unique value; data persists in the
# postgres-data Docker volume across redeploys.
POSTGRES_PASSWORD=
# POSTGRES_DB=geneav
# POSTGRES_USER=geneav
