# Copy to .env.prod on the VM and fill in, then deploy with:
#   docker compose --env-file .env.prod -f docker-compose.yml -f docker-compose.prod.yml up -d --build
#
# GENEAV_HOST is derived from the VM's STATIC public IP using nip.io:
#   IP 20.1.2.3   ->   GENEAV_HOST=geneav.20-1-2-3.nip.io
# (dots in the IP become dashes; the `geneav.` label is optional but tidy)
#
# nip.io resolves the embedded IP automatically — no DNS records to create.
# If Let's Encrypt rate-limits the shared nip.io domain, switch to sslip.io
# (same mechanism: geneav.20-1-2-3.sslip.io) or bring your own registered domain.

GENEAV_HOST=geneav.CHANGE-ME.nip.io
