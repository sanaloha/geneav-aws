# geneav reverse proxy — TLS termination + routing + per-IP rate limiting.
# Apex host comes from GENEAV_HOST (.env.prod); www redirects to the apex.
{
	# rate_limit is a plugin handler, so its order must be declared explicitly.
	order rate_limit before reverse_proxy
}

# Canonicalize www -> apex.
#
# The hostname is derived from GENEAV_HOST by docker-compose.prod.yml rather than
# hardcoded. A hardcoded www.geneav.com made this block wrong in exactly the
# situation it most needed to be right: staging a fresh box on nip.io, where
# geneav.com still points at the previous host. Caddy would try to obtain a
# certificate for a name that does not resolve here, and the redirect would send
# staging traffic to production.
{$GENEAV_WWW_HOST:www.geneav.com} {
	redir https://{$GENEAV_HOST}{uri} permanent
}

# Self-hosted analytics, on its own subdomain.
#
# It cannot live on a path under the apex: Umami is a Next.js app and its
# BASE_PATH is baked in at BUILD time, so the prebuilt image serves its UI and
# its /api/send collection endpoint at the root no matter what BASE_PATH says at
# runtime. Under the apex that endpoint would collide with the scan API, which
# owns /api/*. A subdomain gives it a root of its own and needs no custom image.
#
# Derived from GENEAV_HOST, like the www block above, so a staging run on nip.io
# gets a name that actually resolves to this box. Caddy obtains its certificate
# automatically on first request.
{$GENEAV_ANALYTICS_HOST:analytics.geneav.com} {
	encode gzip
	reverse_proxy umami:3000
}

{$GENEAV_HOST} {
	encode gzip

	# Microsoft Marketplace webhook: MUST be declared ahead of the /api/* block
	# so its per-IP rate limit never applies. Microsoft retries delivery up to
	# 500 times over eight hours from a small set of source IPs — throttling it
	# would silently break subscription lifecycle events. The backend validates
	# the Entra JWT on every call; that, not a rate limit, is the guard here.
	handle /api/v1/marketplace/webhook {
		request_body {
			max_size 1MB
		}
		reverse_proxy backend:8080
	}

	# Scan API → backend. /api prefix PRESERVED (handle, not handle_path).
	handle /api/* {
		request_body {
			max_size 30MB
		}
		rate_limit {
			zone scan_api {
				key {remote_host}
				events 20
				window 1m
			}
		}
		reverse_proxy backend:8080
	}

	# API docs (Swagger UI + OpenAPI JSON) live on the backend but outside /api/*.
	@docs path /docs /docs/* /api-docs /api-docs/* /swagger-ui /swagger-ui/*
	handle @docs {
		reverse_proxy backend:8080
	}

	# Everything else → frontend (Next.js).
	handle {
		reverse_proxy frontend:3000
	}
}
