# geneav reverse proxy — TLS termination + routing + per-IP rate limiting.
# Apex host comes from GENEAV_HOST (.env.prod); www redirects to the apex.
{
	# rate_limit is a plugin handler, so its order must be declared explicitly.
	order rate_limit before reverse_proxy
}

# Canonicalize www -> apex.
www.geneav.com {
	redir https://geneav.com{uri} permanent
}

{$GENEAV_HOST} {
	encode gzip

	# Scan API → backend. /api prefix PRESERVED (handle, not handle_path).
	handle /api/* {
		request_body {
			max_size 30MB
		}
		rate_limit {
			zone scan_api {
				key {remote_host}
				events 20
				window 1m
			}
		}
		reverse_proxy backend:8080
	}

	# API docs (Swagger UI + OpenAPI JSON) live on the backend but outside /api/*.
	@docs path /docs /docs/* /api-docs /api-docs/* /swagger-ui /swagger-ui/*
	handle @docs {
		reverse_proxy backend:8080
	}

	# Everything else → frontend (Next.js).
	handle {
		reverse_proxy frontend:3000
	}
}
